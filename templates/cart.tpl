<section class="ogs-section ogs-page"><header class="ogs-section__head"><h1 class="ogs-section__title">Carrinho</h1></header>{% if cart.items %}<form action="{{ store.cart_url }}" method="post" class="ogs-cart-page">{% for item in cart.items %}<article class="ogs-cart-line"><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | product_image_url('small') | img_tag(item.name) }}{% endif %}</a><div><h2><a href="{{ item.url }}">{{ item.name }}</a></h2><p>{{ item.unit_price | money }}</p><label>Quantidade <input type="number" name="quantity[{{ item.id }}]" value="{{ item.quantity }}" min="0"></label></div><strong>{{ item.subtotal | money }}</strong></article>{% endfor %}<div class="ogs-cart-total"><span>Subtotal</span><strong>{{ cart.subtotal | money }}</strong></div><div class="ogs-cart-actions"><button class="ogs-btn ogs-btn--ghost" type="submit" name="update">Atualizar carrinho</button><button class="ogs-btn ogs-btn--primary" type="submit" name="go_to_checkout">Finalizar compra</button></div></form>{% else %}<p>Seu carrinho está vazio.</p><a class="ogs-btn ogs-btn--primary" href="{{ store.products_url }}">Ver produtos</a>{% endif %}</section>
