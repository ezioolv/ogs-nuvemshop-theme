{% if pages %}<nav class="ogs-pagination" aria-label="Paginação">{% if pages.previous %}<a class="ogs-btn ogs-btn--ghost" href="{{ pages.previous }}">Anterior</a>{% endif %}{% for page in pages.numbers %}{% if page.selected %}<strong>{{ page.number }}</strong>{% else %}<a href="{{ page.url }}">{{ page.number }}</a>{% endif %}{% endfor %}{% if pages.next %}<a class="ogs-btn ogs-btn--ghost" href="{{ pages.next }}">Próxima</a>{% endif %}</nav>{% endif %}
